# Configuración LOCAL del backend.
# Copie este archivo como ".env" (no se sube a git) y complete los valores.
# En Render estas mismas variables se definen en el panel (render.yaml).

# Base de datos de desarrollo (MySQL local). createDatabaseIfNotExist crea "sisfer" si no existe
# y Flyway arma todas las tablas al arrancar.
DB_URL=jdbc:mysql://127.0.0.1:3306/sisfer?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Correo. Opción A (local): contraseña de aplicación de Gmail (SMTP).
MAIL_PASSWORD=
# Opción B (obligatoria en Render): clave API de Brevo. Si está definida, tiene prioridad sobre SMTP.
BREVO_API_KEY=
# Remitente (debe estar verificado en Brevo si se usa la opción B)
MAIL_FROM=ferreteria.lasolucion53@gmail.com
